{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: Contosopizza Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/Contosopizza/Contosopizza.csproj"
        },

        {
            "name": "C#: mslearn-dotnet-files Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/mslearn-dotnet-files/mslearn-dotnet-files.csproj"
        },
        {
            "name": "C#: DotNetDebugging Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/DotNetDebugging/DotNetDebugging.csproj"
        },
        {
            "name": "C#: U03 BlazorApp Debug",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/U03learning/BlazorApp/bin/Debug/net10.0/BlazorApp.dll",
            "cwd": "${workspaceFolder}/U03learning/BlazorApp",
            "args": [
                "--urls",
                "http://localhost:5258"
            ],
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "console": "internalConsole",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            }
        }
    ]
}